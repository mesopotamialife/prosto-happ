Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Happ\OrganizationDefaults\Preferences]
"language"="ru"
"mode"="Light"
"fontScale"="1"

[HKEY_CURRENT_USER\Software\Happ\OrganizationDefaults\Preferences\AdvancedSettings]
"autoStart"="true"
"tun"="false"
"tunMode"=dword:00000000
"tunProvider"="sing-box"

[HKEY_CURRENT_USER\Software\Happ\OrganizationDefaults\Preferences\PingSettings]
"pingTestUrl"="http://www.gstatic.com/generate_204"
"pingType"=dword:00000001
"proxyPingMode"="double"

[HKEY_CURRENT_USER\Software\Happ\OrganizationDefaults\Preferences\Subscriptions]
"subsSendHWID"="true"
"subsAlternativeHWID"="true"
"subsUpdateOnOpen"="true"
"subsAutoUpdate"="true"
"subsReadOnlyHWID"="true"

[HKEY_CURRENT_USER\Software\Happ\OrganizationDefaults\Preferences\TunnelSettings\Routing]
"geoFilesUserAgent"="firefox-win"

[HKEY_CURRENT_USER\Software\Policies\Google\Chrome]
"ProxySettings"="{\"ProxyMode\":\"system\"}"
